rules_version = '2';
// Todo acesso a dados passa pela API (Admin SDK), que aplica RBAC e isolamento por gabinete.
// O navegador só lê o próprio perfil. Nenhum cliente escreve diretamente — isso elimina a
// escalada de privilégio por edição do campo `role`.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }
  }
}
