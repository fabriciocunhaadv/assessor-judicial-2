# ───────── Servidor ─────────
PORT=8787
NODE_ENV=development
# Somente em desenvolvimento local: ignora a verificação do ID Token do Firebase.
# Em produção esta flag é IGNORADA (o servidor recusa subir com ela ativa).
AUTH_DISABLED=false
# E-mails com papel super_admin garantido (separados por vírgula)
SUPER_ADMIN_EMAILS=

# ───────── Firebase (Admin SDK no servidor) ─────────
# Caminho para o JSON da service account OU deixe vazio para usar Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=
# memory = repositório em memória (dev/testes) | firestore = produção
DATA_BACKEND=memory

# ───────── Firebase (SDK Web — prefixo VITE_ fica exposto ao navegador; são chaves públicas) ─────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_AUTH_DISABLED=false

# ───────── Motor de IA: Claude (Anthropic) ─────────
# Pool de chaves: várias chaves separadas por vírgula (rotação automática em 429 / crédito esgotado)
ANTHROPIC_API_KEYS=
# Cascata de modelos (primeiro = preferencial). Ex.: claude-opus-5-5,claude-sonnet-5-5
ANTHROPIC_MODELS=claude-opus-5-5
# Esforço padrão: low | medium | high | xhigh | max (cada tarefa já define o seu; este vale para o resto)
ANTHROPIC_EFFORT=high

# Retentativas por modelo em 429/529/timeout
AI_MAX_RETRIES=3
AI_BASE_DELAY_MS=1500
AI_TIMEOUT_MS=600000

# Cotação para o painel de custos
USD_BRL=5.40
